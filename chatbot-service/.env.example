# Chatbot service settings. Copy to .env and fill in; never commit .env.
# Every value below is the default unless marked "required".

# --- Knowledge base (required: WP_BASE_URL + WP_SHARED_SECRET, or KB_FILE) ---
WP_BASE_URL=https://www.example.org
# Same value as ORG_CHATBOT_SHARED_SECRET in wp-config.php.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WP_SHARED_SECRET=
# Local JSON instead of WordPress (development): KB_FILE=eval/data/sample_kb.json
KB_FILE=
KB_TTL_SECONDS=60
HTTP_TIMEOUT_SECONDS=5

# Browser origins allowed to call the service (comma-separated). Required in production.
ALLOWED_ORIGINS=https://www.example.org

# --- FAQ matching ---
# embedding (all-MiniLM-L6-v2, better on rephrasings) or lexical (no download)
MATCHER=embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave empty for the matcher's default; set from: python eval/run_eval.py --calibrate
MATCH_THRESHOLD=
MATCH_MARGIN=0.0
SUGGEST_RATIO=0.6
MAX_MESSAGE_CHARS=300

# --- Speech recognition (E-Branchformer via ESPnet) ---
ASR_ENABLED=true
ASR_MODEL_TAG=espnet/owsm_v3.1_ebf_base
ASR_DEVICE=cpu
# 1 = fastest (greedy); 3 = more accurate, still under ~1.6 s on a laptop CPU
ASR_BEAM_SIZE=1
ASR_CTC_WEIGHT=0.0
ASR_LANG_SYM=<eng>
ASR_QUANTIZE=true
# 0 = let PyTorch decide
ASR_THREADS=0
ASR_REQUIRE_EBRANCHFORMER=true
ASR_MAX_SECONDS=15
ASR_MIN_SECONDS=0.4
ASR_MAX_UPLOAD_BYTES=1500000

# --- Abuse protection and reporting ---
RATE_LIMIT_PER_MINUTE=20
# true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
REPORT_UNANSWERED=true
